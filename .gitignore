# OS Files
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================================
# Temporary Files
# ==========================================================

*.tmp
*.bak

# ==========================================================
# IMPORTANT:
# DO NOT IGNORE THESE
#
# Core/
# Drivers/
# Middlewares/
# X-CUBE-AI/
# *.ioc
# *.ld
# Core/Inc/scaler_data.h
#
# These are required so a fresh clone can build
# and flash directly on STM32CubeIDE.
