*.elf
*.hex
*.bin
*.map
*.list

# Intermediate build files
*.o
*.d
*.su
*.cyclo

# ==========================================================
# IDE Metadata
# ==========================================================

.settings/
.metadata/

# VSCode
.vscode/

# ==========================================================
# Python
# ==========================================================

__pycache__/
*.pyc
*.pyo
*.pyd

.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

